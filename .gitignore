# Unity .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Keep this file in the project root, next to the Assets folder.

# ---- Folders Unity generates on each computer ----
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files (Unity imports .blend files directly)
*.blend1
*.blend1.meta

# Memory captures and recordings can get very large
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Uncomment this line to ignore the Asset Store Tools plugin
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Gradle cache (Android builds)
.gradle/

# Code editor project files (Unity recreates these)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# Scenes generated by the Test Runner
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables build output
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ---- Extra: code editors, Mac files, archives ----
.vsconfig
.vscode/
Icon?
.DS_Store
.idea/
.vs/
*.7z
.fake
__MACOSX/

# "Icon?" above also matches folders named "Icons" (like Assets/TutorialInfo/Icons).
# This line keeps those folders in Git.
!Icons/
